<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->

    <bean id="carSpecs" class="com.spring_beans.car.Spacifications">
        <property name= "make" value="Toyota"></property>
        <property name= "model" value="Corolla"></property>
    </bean>

    <bean id="spacifications1" class="com.spring_beans.car.Spacifications">
        <property name= "make" value="Honda"></property>
        <property name= "model" value="Civic"></property>
    </bean>

    <bean id="myCar" class="com.spring_beans.car.Car">
        <constructor-arg ref="carSpecs"></constructor-arg>
    </bean>

<!-- auto wiring by name, type and constuctor -->
   <bean id="myCar2" class="com.spring_beans.car.Car2" autowire="byName"/>
        

</beans>